# =============================================================================
# PostgreSQL (Prisma)
# =============================================================================
# Docker Compose reads OPENLEARN_DB_PORT for the host port (default 5434).
# Must match the port inside DATABASE_URL below.
# If you see "port is already allocated", set a free port (e.g. 55432) and match DATABASE_URL.
OPENLEARN_DB_PORT=59123
# Docker Compose in this repo — user/pass/db: openlearn
# Use 127.0.0.1 to avoid some IPv6/localhost quirks on macOS.
# Comma-separated emails that skip the free-tier coin economy (treated as PRO).
PRO_LEARNER_EMAILS=

DATABASE_URL="postgresql://openlearn:openlearn@127.0.0.1:59123/openlearn?schema=public"
#
# If Prisma says credentials for user `openlearn` are invalid but they match
# docker-compose.yml, the Postgres volume was likely created with OLD env vars.
# Reset: npm run docker:reset && npm run docker:up && npm run db:push && npm run db:seed

# =============================================================================
# Clerk — https://dashboard.clerk.com → API Keys
# =============================================================================
# Publishable key starts with pk_test_ (dev) or pk_live_ (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Secret key starts with sk_test_ (dev) or sk_live_ (production)
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# =============================================================================
# AI — pick ONE provider with AI_PROVIDER; set keys only for that provider
# =============================================================================
# Options: mock | openai | anthropic
# - mock  → no API keys needed (built-in sample roadmaps)
# - openai → set OPENAI_API_KEY (and optionally OPENAI_MODEL)
# - anthropic → set ANTHROPIC_API_KEY (and optionally ANTHROPIC_MODEL)
AI_PROVIDER=mock

# --- OpenAI (https://platform.openai.com/api-keys) ---
# Uncomment these when AI_PROVIDER=openai
# OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# OPENAI_MODEL="gpt-4o-mini"
# Optional: cap for JSON roadmap responses (default 16384). Lower only if your model errors on high limits.
# OPENAI_MAX_OUTPUT_TOKENS=8192
# Optional: organization id if your key requires it
# OPENAI_ORG_ID="org-xxxxxxxxxxxxxxxx"

# --- Anthropic (https://console.anthropic.com/settings/keys) ---
# Uncomment these when AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ANTHROPIC_MODEL="claude-3-5-haiku-20241022"
