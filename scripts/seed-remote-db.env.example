# Copy to repo root as .env.remote.local (gitignored):
#   cp scripts/seed-remote-db.env.example .env.remote.local
#
# Use a key name that Next/dev will not load by accident.
# Used by: ./scripts/migrate-remote-db.sh (npm run db:migrate:remote)
#          ./scripts/seed-remote-db.sh
REMOTE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
